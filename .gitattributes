agamemnon/cli.py text eol=lf
agamemnon/engine/route_replay.py text eol=lf
agamemnon/templates/mcu-fpga-registers/logic/top.v text eol=lf
agamemnon/templates/mcu-fpga-registers/logic/complete_byte_waited8.v text eol=lf
# Every routed-JSON and Verilog checkpoint in this template's logic directory is
# hash-pinned (source_sha256/routed_sha256 in agamemnon/sdk/qualified_fabric_profiles.json,
# CORE_SHA256 in agamemnon/engine/status_overlay.py, and the sdk-workflow tests).
# Pin the whole directory to canonical LF so new checkpoints (e.g. the public32
# exact-map/gpio5/autoevent set) cannot drift their hashes on Windows/autocrlf
# checkouts the way per-file pins let them. Was CI-red on windows-test.
agamemnon/templates/mcu-fpga-registers/logic/*.v text eol=lf
agamemnon/templates/mcu-fpga-registers/logic/*.json text eol=lf
agamemnon/templates/serv-blinky/** text eol=lf

# Exact timing is hash-pinned by its manifest; force one checkout identity.
agamemnon/chipdb/wire_timing_exact_safe.json text eol=lf
agamemnon/chipdb/wire_timing_exact_safe_manifest.json text eol=lf

# RMUX30 admission references authenticate exact JSON bytes; keep their
# checkout identity invariant on Windows and Unix hosts.
agamemnon/chipdb/routing_selector_admission.json text eol=lf
agamemnon/chipdb/routing_rmux30_*.json text eol=lf
# All shipped chip-database text is canonical LF on every checkout so the
# research-knowledge manifest's raw-byte hashes are stable (was CI-red via
# CRLF-vs-LF-only diffs on Windows/autocrlf checkouts).
agamemnon/chipdb/*.csv text eol=lf
agamemnon/chipdb/*.json text eol=lf
agamemnon/chipdb/*.txt text eol=lf

# Qualified SDK checkpoints (routed JSON, source Verilog) are hash-pinned by the
# pack-audit gate; canonical LF on every checkout so Windows/autocrlf cannot
# drift their source hashes (was CI-red on the installed-wheel BRAM pack).
agamemnon/sdk/**/*.json text eol=lf
agamemnon/sdk/**/*.jsonl text eol=lf
agamemnon/sdk/**/*.v text eol=lf

tools/import_rmux30_routing_admission.py text eol=lf

# Runtime and research databases are normal Git objects. The executable pickle
# graphs were replaced by compact AGDB files, so a current checkout needs no
# Git LFS client.

# The installed status overlay's strict-devdb snapshot is hash-pinned
# (DEVDB_MANIFEST_SHA256 in agamemnon/engine/status_overlay.py) and must be
# byte-identical on every checkout. Mark the gzip artifacts explicitly
# binary so git's text=auto heuristic can never subject them to autocrlf
# translation, and pin the manifest JSON to canonical LF like the other
# hash-pinned chipdb tables above.
agamemnon/engine/status_overlay_dev_pips.csv.gz binary
agamemnon/engine/status_overlay_dev_belpins.csv.gz binary
agamemnon/engine/status_overlay_devdb_manifest.json text eol=lf
