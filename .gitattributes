# Auto detect text files and perform LF normalization
* text=auto
*.sh text eol=lf
*.patch text eol=lf
qualification/pack_reproduction_evidence.jsonl text eol=lf

# Hash-verified qualification text is canonical LF on every checkout.
# Evidence checked-prefix hashes and retained text-source hashes use canonical
# LF; routed JSON uses the same rule and is pinned as well so
# every maintained qualification surface has one checkout identity.
qualification/*.v text eol=lf
qualification/*.jsonl text eol=lf
qualification/*.py text eol=lf
qualification/*.c text eol=lf
qualification/*.json text eol=lf
qualification/*routed*.json text eol=lf
# N5.8B alternate-terminal HIL identities are hashed from exact checkout bytes.
qualification/n58b_hwdata25_i1_hil_s01/*.md text eol=lf
qualification/n58b_hwdata25_i1_hil_s01/*.py text eol=lf
qualification/n58b_hwdata25_i1_hil_s01/*.v text eol=lf
qualification/n58b_hwdata25_i1_hil_s01/*.pcf text eol=lf
qualification/n58b_hwdata25_i1_hil_s01/*.json text eol=lf
qualification/n58b_hwdata25_i1_hil_s01/*.c text eol=lf
qualification/n58b_hwdata25_i1_hil_s01/artifacts/*.json text eol=lf
qualification/n58b_hwdata25_i1_hil_s01/artifacts/*.bin binary
qualification/n58b_hwdata25_i1_hil_s01/artifacts/*.bin.comp binary
qualification/n58b_hwdata25_i1_hil_s01/artifacts/*.elf binary
