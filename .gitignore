# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.pytest_cache/
.tmp/
.venv/
venv/

# --- Large / derived chip-database data ---
# .csv/.bin are ignored globally (scratch, harvested tables, build outputs)...
chipdb.json
*.csv
*.img
*.bin
*.bin.comp

# ...but the SHIPPED device database + golden test fixtures MUST be committed (they're what makes
# this "clone and go"): the chipdb, and the round-trip vectors. Re-include them explicitly.
!agamemnon/chipdb/
!agamemnon/chipdb/**
!tests/fixtures/
!tests/fixtures/**
# the engine ships one data table (BRAM/PLL config bits) alongside its .py — a fresh clone needs it
!agamemnon/engine/*.csv

# --- Emitted arch graph (regenerated by the arch emitter) ---
agrv2k_arch.json
*_arch.json

# --- nextpnr working tree for the agrv2k uarch overlay ---
# build.sh clones nextpnr here and overlays engine/uarch/agrv2k/*.cc; not committed as a raw tree
# (it becomes a pinned submodule per engine/uarch/agrv2k/README.md).
third_party/

# firmware build intermediates (the .c is the source; .bin/.elf are rebuilt)
examples/firmware/*.elf

# agrv2k uarch build artifacts (regenerated: emit_uarch_db.py -> devdb; nextpnr runs -> _stage1)
agamemnon/engine/uarch/agrv2k/devdb/
agamemnon/engine/uarch/agrv2k/devdb_*/
agamemnon/engine/uarch/agrv2k/_stage1/
agamemnon/engine/uarch/agrv2k/_serv/

# Durable qualification queues are local bench state; evidence exports are tracked.
qualification/*.sqlite3
