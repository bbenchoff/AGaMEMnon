# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.pytest_cache/
.venv/
venv/

# --- Large / derived chip-database data ---
# .csv/.bin are ignored globally (scratch, harvested tables, build outputs)...
chipdb.json
*.csv
*.img
*.bin

# ...but the SHIPPED device database + golden test fixtures MUST be committed (they're what makes
# this "clone and go"): the chipdb, and the round-trip vectors. Re-include them explicitly.
!agamemnon/chipdb/
!agamemnon/chipdb/**
!tests/fixtures/
!tests/fixtures/**

# --- Emitted arch graph (regenerated by the arch emitter) ---
agrv2k_arch.json
*_arch.json
