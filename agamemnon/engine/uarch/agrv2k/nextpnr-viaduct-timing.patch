diff --git a/generic/arch.cc b/generic/arch.cc
index 48021029..fca15e8a 100644
--- a/generic/arch.cc
+++ b/generic/arch.cc
@@ -439,6 +439,19 @@ NetInfo *Arch::getBoundWireNet(WireId wire) const { return wire_info(wire).bound

 NetInfo *Arch::getConflictingWireNet(WireId wire) const { return wire_info(wire).bound_net; }

+DelayQuad Arch::getWireDelay(WireId wire) const
+{
+    DelayQuad delay;
+    if (uarch && uarch->getWireDelay(wire, delay))
+        return delay;
+    return DelayQuad(0);
+}
+
+IdString Arch::getWireConstantValue(WireId wire) const
+{
+    return uarch ? uarch->getWireConstantValue(wire) : IdString();
+}
+
 const std::vector<BelPin> &Arch::getWireBelPins(WireId wire) const { return wire_info(wire).bel_pins; }

 linear_range<WireId> Arch::getWires() const { return linear_range<WireId>(wires.size()); }
@@ -522,7 +530,13 @@ WireId Arch::getPipSrcWire(PipId pip) const { return pip_info(pip).srcWire; }

 WireId Arch::getPipDstWire(PipId pip) const { return pip_info(pip).dstWire; }

-DelayQuad Arch::getPipDelay(PipId pip) const { return DelayQuad(pip_info(pip).delay); }
+DelayQuad Arch::getPipDelay(PipId pip) const
+{
+    DelayQuad delay;
+    if (uarch && uarch->getPipDelay(pip, delay))
+        return delay;
+    return DelayQuad(pip_info(pip).delay);
+}

 const std::vector<PipId> &Arch::getPipsDownhill(WireId wire) const { return wire_info(wire).downhill; }

