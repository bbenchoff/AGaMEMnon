+    // Diagnostic only: called after workers finish, without modifying routing state.
+    void write_congested_wire_owners(std::ostream &out)
+    {
+        auto quoted = [](const char *value) {
+            std::string result = "\"";
+            for (const char *p = value; *p; ++p) {
+                if (*p == '\"')
+                    result += '\"';
+                result += *p;
+            }
+            return result + "\"";
+        };
+        out << "wire,net,occupancy,incoming_pip\n";
+        for (size_t i = 0; i < nets_by_udata.size(); i++) {
+            for (const auto &wire : nets.at(i).wires) {
+                const auto &wd = flat_wires.at(wire_to_idx.at(wire.first));
+                if (wd.curr_cong <= 1)
+                    continue;
+                out << quoted(ctx->nameOfWire(wire.first)) << ","
+                    << quoted(nets_by_udata.at(i)->name.c_str(ctx)) << "," << wd.curr_cong << ","
+                    << quoted(wire.second.first == PipId() ? "" : ctx->nameOfPip(wire.second.first)) << "\n";
+            }
+        }
+    }
+
+    void write_route_endpoints(std::ostream &out)
+    {
+        auto quoted = [](const char *value) {
+            std::string result = "\"";
+            for (const char *p = value; *p; ++p) {
+                if (*p == '\"')
+                    result += '\"';
+                result += *p;
+            }
+            return result + "\"";
+        };
+        out << "net,source,sink\n";
+        for (size_t i = 0; i < nets_by_udata.size(); i++) {
+            const auto &net = nets.at(i);
+            for (const auto &user : net.arcs)
+                for (const auto &arc : user)
+                    out << quoted(nets_by_udata.at(i)->name.c_str(ctx)) << ","
+                        << quoted(net.src_wire == WireId() ? "" : ctx->nameOfWire(net.src_wire)) << ","
+                        << quoted(ctx->nameOfWire(arc.sink_wire)) << "\n";
+        }
+    }
+
